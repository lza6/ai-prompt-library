{
  "manifest_version": 3,
  "name": "CyberStrike 知乎正文导入",
  "version": "1.0.0",
  "description": "将当前知乎专栏文章的已渲染页面导入本机阅读器。仅在手动点击时运行。",
  "key": "",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8420/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "导入当前知乎文章" }
}
